# Copy to .env and edit. Only the first block is required.
#   cp .env.sample .env
# .env is gitignored and excluded from the Docker build context, so it never
# reaches the image or the repository.

# --- Required ---------------------------------------------------------------

# The public hostname. Its A/AAAA record must already point at this host, and
# ports 80 and 443 must be reachable, or Caddy cannot obtain a certificate.
PUBLIC_DOMAIN=a11y.example.com

# Login for the dashboard. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Only the hash is ever stored, so a leaked .env does not leak the password.
# Keep the single quotes: they stop the leading $ of the hash from being read
# as a variable reference. Left as-is, the placeholder below is not a valid
# hash, so logins will fail loudly rather than silently.
DASHBOARD_USER=alice
DASHBOARD_PASSWORD_HASH='$2a$14$replace.this.with.a.generated.hash'

# Where to send certificate expiry warnings.
ACME_EMAIL=ops@example.com

# --- Optional ---------------------------------------------------------------

# Nightly test run, as a six-field crontab (seconds first). The default is
# 02:30 every day. This schedule runs serially, one URL at a time.
WEBSERVICE_CRON=0 30 2 * * *

# Timezone for the schedule above. The base image may not ship the timezone
# database, in which case this is ignored and the schedule runs on UTC instead.
# Check with `docker compose exec dashboard date`, and if it prints UTC, either
# shift the cron expression to match or add tzdata to the runtime stage of
# Dockerfile.example.
TZ=Europe/Berlin

# Set to true for a view-only instance: nobody can add, edit, delete or run
# URLs. This is a convenience, not a security control.
READONLY=false
